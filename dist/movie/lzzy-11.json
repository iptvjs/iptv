:0,"vod_down":0,"vod_score":"0.0","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-09-07 17:11:43","vod_time_add":1788772303,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":37070422,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_pwd_play_url":"","vod_pwd_down":"","vod_pwd_down_url":"","vod_content":"改编自同名小说，故事描述主角久喜雄司住在长野乡下，某日出差回来，妻子夕里子告诉他，家里的墓地发生了怪事。雄司从未见过的伯公久喜贞市年轻时即战死于南洋，他被刻在家族墓碑上的名字不知道何时被人给削掉了。同时，家里也接到来自当地报社的联络，报社记者表示她因为进行战死者慰灵祭的报导，从贞市死亡的所在地巴布亚纽吉内亚的当地人手里获得了贞市死前的日记。这本日记描写了贞市死前的行动，他如何和战友在当地丛林里苟延残喘，最后无奈死于澳洲军人的枪下等等。其中也提到贞市和战友一直企图诱捕当地的巨大鸟类食火鸡不可得的过程。雄司和家人阅读这本日记的过程中深刻地感受到了贞市对于「活下来」一事的执着。然而，随着这本日记进入久喜家，雄司身边也开始发生怪事，先是贞市战友的家中失火，再来是贞市弟弟亦是雄司的爷爷失踪，墓碑居然还出现了爷爷的名字，死亡日期更是记载为雄司父亲多年前车祸去世的日期…","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"HD中字$https:\/\/v.lzcdn27.com\/20260907\/16561_812c0ebd\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"HD中字$https:\/\/dow.lzdown29.com\/20260907\/16561_812c0ebd\/吃了食火鸡 火喰鳥を、喰う (2025).mp4","vod_plot":0,"vod_plot_name":"","vod_plot_detail":"","type_name":"剧情片"},{"vod_id":155737,"type_id":11,"type_id_1":1,"group_id":0,"vod_name":"恨女的逆袭","vod_sub":"A Dance With Rainbows","vod_en":"hennvdenixi","vod_status":1,"vod_letter":"H","vod_color":"","vod_tag":"","vod_class":"运动","vod_pic":"https:\/\/img.lzipic.com\/upload\/vod\/20260904-1\/f8e50e926266fa79fd4963393a67ce81.webp","vod_pic_thumb":"","vod_pic_slide":"","vod_pic_screenshot":null,"vod_actor":"李千娜,王彩桦,游安顺,蔡振南,田翔元,曾皓泽,黄惟,林毓家,林怡婷","vod_director":"李宜珊","vod_writer":"李宜珊","vod_behind":"","vod_blurb":"拳来不要闭眼，机会一到，一拳狠狠打出去。面对成长的痛击，家玲迎难而上，等待逆袭的时机。她一边到拳馆苦练，一边帮妈妈经营便当生意。父母的婚姻已名存实亡，她不懂如何配合大人的游戏规则，擂台上甚至有人打假拳","vod_remarks":"HD","vod_pubdate":"2026-01-16(中国台湾)","vod_total":0,"vod_serial":"","vod_tv":"","vod_weekday":"","vod_area":"中国台湾","vod_lang":"汉语普通话","vod_year":"2026","vod_version":"","vod_state":"","vod_author":"","vod_jumpurl"