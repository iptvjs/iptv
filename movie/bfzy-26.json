od_director":"王洋","vod_writer":"","vod_behind":"","vod_blurb":"秦国早期，护驾功高的西垂大夫赢氏父子在周平王大宴群臣时遭受冷遇，周平王省悟，封其父为秦侯。秦侯返回西垂（今甘肃天水陇南一带），故地被西戎占据，并掳去老祖母，以交出秦侯金印相要挟，赢硕扮作晋商深入西戎，智斗义渠单于，化干戈为玉帛。秦侯亡故，赢硕继位，励精图治，严秦法，安百姓，和西戎，为铸秦鼎，经历了血与火的情感撞击，祭天大典上又面临正与邪的生死较量，他从容应对，重秦法如山，凝聚了秦人心，激励起秦人志。西风烈、旌旗扬，年轻的大秦文公赢硕率秦人东进关中，为收复沣镐，为秦国大出天下奠定了第一块基石。五百年后，秦始","vod_remarks":"更新至HD","vod_pubdate":"","vod_total":0,"vod_serial":"0","vod_tv":"","vod_weekday":"","vod_area":"中国大陆","vod_lang":"汉语普通话","vod_year":"2026","vod_version":"","vod_state":"","vod_author":"","vod_jumpurl":"","vod_tpl":"","vod_tpl_play":"","vod_tpl_down":"","vod_isend":0,"vod_lock":0,"vod_level":0,"vod_copyright":0,"vod_points":0,"vod_points_play":0,"vod_points_down":0,"vod_hits":545,"vod_hits_day":0,"vod_hits_week":0,"vod_hits_month":0,"vod_duration":"","vod_up":0,"vod_down":0,"vod_score":"0.0","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-11-20 11:50:12","vod_time_add":1795146612,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":36737231,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_pwd_play_url":"","vod_pwd_down":"","vod_pwd_down_url":"","vod_content":"秦国早期，护驾功高的西垂大夫赢氏父子在周平王大宴群臣时遭受冷遇，周平王省悟，封其父为秦侯。秦侯返回西垂（今甘肃天水陇南一带），故地被西戎占据，并掳去老祖母，以交出秦侯金印相要挟，赢硕扮作晋商深入西戎，智斗义渠单于，化干戈为玉帛。秦侯亡故，赢硕继位，励精图治，严秦法，安百姓，和西戎，为铸秦鼎，经历了血与火的情感撞击，祭天大典上又面临正与邪的生死较量，他从容应对，重秦法如山，凝聚了秦人心，激励起秦人志。西风烈、旌旗扬，年轻的大秦文公赢硕率秦人东进关中，为收复沣镐，为秦国大出天下奠定了第一块基石。五百年后，秦始皇统一中国。","vod_play_from":"bfzym3u8","vod_play_server":"","vod_play_note":"","vod_play_url":"HD$https:\/\/v.fengbao14.com\/video\/daqinwengong\/8c65e4428c90\/index.m3u8","vod_down_from":"","vod_down_server":"","vod_down_note":"","vod_down_url":"","vod_plot":0,"vod_plot_name":"","vod_plot_detail":"","type_name":"剧情片"},{"vod_id":173751,"type_id":26,"type_id_1":20,"group_id":0,"vod_name":"完美说谎者","vod_sub":"Perfect Liars","vod_en":"wanmeishuohuangzhe","vod_status":1,"vod_letter":"W","vod_color":"","vod_tag":"","vod_class":"","vod_pic":"https:\/