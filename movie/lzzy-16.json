score_num":0,"vod_time":"2026-11-08 01:03:01","vod_time_add":1794070981,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":37458816,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_pwd_play_url":"","vod_pwd_down":"","vod_pwd_down_url":"","vod_content":"1985年11月6日，波哥大的天空被硝烟撕裂。M-19游击队如同一道黑色闪电，突袭了哥伦比亚司法宫——这座国家法律的圣殿，在短短数小时内沦为人间炼狱。交火的枪声、绝望的人质呼救、军队重武器的轰鸣、游击队孤注一掷的呐喊，在首都心脏地带交织成一曲末日的交响。整个国家眼睁睁看着战争第一次撕裂了文明的面具，27小时的恐怖，如同烧红的烙铁，在哥伦比亚的历史上烙下了永不磨灭的伤痕。                                                                      　　然而，当硝烟散尽，当废墟被清理，当官方的叙事被精心编织，真相却被掩埋在了司法宫的瓦砾之下。四名女性，带着失去至亲的痛楚与对正义的执念，在沉默与威胁中坚持不懈地调查，要揭开这场悲剧背后被刻意隐藏的真相。她们面对的，不仅是一个国家最黑暗的秘密，更是一个被权力与暴力扭曲的司法体系——在那里，幸存者的声音被消音，失踪者的名字被遗忘，而正义，成为了最昂贵的奢侈品。","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"第01集$https:\/\/v.lfthirtytwo.com\/20261108\/11573_cb50ce1c\/index.m3u8#第02集$https:\/\/v.lfthirtytwo.com\/20261108\/11578_4cba2aed\/index.m3u8#第03集$https:\/\/v.lfthirtytwo.com\/20261108\/11577_d890e3ad\/index.m3u8#第04集$https:\/\/v.lfthirtytwo.com\/20261108\/11576_8959af9d\/index.m3u8#第05集$https:\/\/v.lfthirtytwo.com\/20261108\/11572_98300ecf\/index.m3u8#第06集$https:\/\/v.lfthirtytwo.com\/20261108\/11575_799bd34a\/index.m3u8#第07集$https:\/\/v.lfthirtytwo.com\/20261108\/11574_28ef2087\/index.m3u8#第08集$https:\/\/v.lfthirtytwo.com\/20261108\/11571_6bc5cdc9\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"第01集$https:\/\/dow.lzdown29.com\/20261108\/11573_cb50ce1c\/围城困局01.mp4#第02集$https:\/\/dow.lzdown29.com\/20261108\/11578_4cba2aed\/围城困局02.mp4#第03集$https:\/\/dow.lzdown29.com\/20261108\/11577_d890e3ad\/围城困局03.mp4#第04集$https:\/\/dow.lzdown29.com\/20261108\/11576_8959af9d\/围城困局04.mp4#第05集$https:\/\/dow.lzdown29.com\/20261108\/11572_98300ecf\/围城困局05.mp4#第06集$https:\/\/dow.lzdown29.com\/20261108\/11575_799bd34a\/围城困局06.mp4#第07集$https:\/\/dow.lzdown29.com\/20261108\/11574_28ef2087\/围城困