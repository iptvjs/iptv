ng":"瑞典语","vod_year":"2026","vod_version":"","vod_state":"","vod_author":"","vod_jumpurl":"","vod_tpl":"","vod_tpl_play":"","vod_tpl_down":"","vod_isend":0,"vod_lock":0,"vod_level":0,"vod_copyright":0,"vod_points":0,"vod_points_play":0,"vod_points_down":0,"vod_hits":539,"vod_hits_day":0,"vod_hits_week":0,"vod_hits_month":0,"vod_duration":"46分钟","vod_up":0,"vod_down":0,"vod_score":"0.0","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-10-31 08:31:26","vod_time_add":1793406686,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":37935393,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_pwd_play_url":"","vod_pwd_down":"","vod_pwd_down_url":"","vod_content":"Helene(Frida Gustavsson 饰)与 Carl(Fares Fares 饰)住在斯德哥尔摩群岛一带，婚姻关系正面临危机。为了挽救感情，两人决定与生活在西西里的另一对伴侣Scarlett(Emma Appleton 饰)和Adam(Jakob Oftebro 饰)交换住所，暂时离开原有的生活环境。                                                                      　　交换刚开始时，一切看似理想：一对来到阳光充足的西西里别墅，另一对则入住斯德哥尔摩群岛的现代住宅。然而，入住之后出现的种种异常逐渐打破了这种理想生活。                                                                      　　房屋里有不合理的细节，陌生人的行为令人起疑，原本互不相识的两对伴侣也开始发现彼此的生活并不像表面看起来那么简单。秘密与背叛不断浮现，住所交换渐渐演变成一场充满监视、操纵和猜疑的心理游戏。                                                                      　　随着事件发展，两对伴侣不得不重新审视自己最亲密的人：究竟哪些事情是真相，哪些只是精心维持的假象？当信任开始瓦解，他们又能否分辨自己正在面对的是欺骗，还是自己不愿承认的现实？                                                                      　　这部剧的悬疑核心并非单纯的房屋交换，而是亲密关系中隐藏的秘密，以及人们为了保护自己会走到什么地步。","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"第01集$https:\/\/v.lzcdn27.com\/20261031\/20803_a79d4e30\/index.m3u8#第02集$https:\/\/v.lzcdn27.com\/20261031\/20802_0a50f508\/index.m3u8#第03集$https:\/\/v.lzcdn27.com\/20261031\/20801_0c6e6d9e\/index.m3u8#第04集$https:\/\/v.lzcdn27.com\/20261031\/20800_2c687103\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"第01集$https:\/\/dow.lzdown29.com\/20261031\/20803_a79d4e30\/