":0,"vod_hits_month":0,"vod_duration":"","vod_up":0,"vod_down":0,"vod_score":"0.0","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-10-11 07:25:42","vod_time_add":1791674742,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":38682208,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_pwd_play_url":"","vod_pwd_down":"","vod_pwd_down_url":"","vod_content":"本作是一部人物剧，故事从一名独自生活在人烟稀少的工房中的家具工匠，与一名为未来而烦恼的大学生相遇开始。                                                                      　　故事的主人公是家具工匠柊恒一。他年轻时为了追逐梦想远赴意大利，并成为首位以日本人身份获得权威设计奖项的家具工匠，在日本国内外都获得了高度评价。然而，在这份光鲜亮丽的成功背后，他始终无法认为自己已经成为了一名真正独当一面的工匠。                                                                      　　年轻时前往意大利之际，他曾与自己暗自怀有恋慕之情的同学薰约定：“等我成为真正独当一面的人，一定会回来。”然而，这个约定始终未能兑现。如今，他已经失去了作为工匠进行创作的热情，独自隐居在深山中的工作室里，过着悄无声息的生活。                                                                      　　一天，正在求职的大学生守谷夏树来到他的面前。夏树拿出来的是一个摔裂的威士忌酒杯，并说道：“我把祖母珍爱之物弄坏了，请您帮忙修好它。”柊正准备将夏树赶走，却发现他竟然是薰的孙子。","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"HD中字$https:\/\/v.lzcdn27.com\/20261011\/18732_8895ec33\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"HD中字$https:\/\/dow.lzdown29.com\/20261011\/18732_8895ec33\/金缮 きんつくろい -金繕い- (2026).mp4","vod_plot":0,"vod_plot_name":"","vod_plot_detail":"","type_name":"剧情片"},{"vod_id":160749,"type_id":11,"type_id_1":1,"group_id":0,"vod_name":"全城追缉","vod_sub":"","vod_en":"quanchengzhuiji","vod_status":1,"vod_letter":"Q","vod_color":"","vod_tag":"","vod_class":"剧情,犯罪","vod_pic":"https:\/\/img.lzipic.com\/upload\/vod\/20261011-1\/62f8fa0e346214b9ed19ce4d0bd52938.webp","vod_pic_thumb":"","vod_pic_slide":"","vod_pic_screenshot":null,"vod_actor":"凌潇肃,余男,郭晓东,吴若甫,程莉莎,王韬","vod_director":"崔景宣","vod_writer":"钱伟,胡荣华,王基诺","vod_behind":"","vod_blurb":"本世纪初，街头飞抢横行，民众人人自危。佛山公安组建全国首支打击街面 “双抢” 专业队刑警八大队，副队长林伟带队骑摩托奔赴一线，与飞车劫匪展开常年生死追缉。十一年间，八大队抓获嫌疑人两万余名，林伟三十余","